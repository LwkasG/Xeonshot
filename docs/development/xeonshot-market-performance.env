# Optional base-frame throughput preset for the tested Xeon E5-2686 v4 / RTX 5080.
# Merge into hookshot_env.txt for a local Xeonshot run. In the menu, keep the
# game's own upscaler at 100% and the existing market geometry and shadow settings.
HOS_BG_CAP=5
HOS_OUTPUT_RES=3440x1440
RX_VK_ASYNC=1
RX_VK_RECORDER=thread
RX_VK_PARALLEL=0
RX_VK_DESCRIPTOR_SETS=0
RX_VK_FRAMEGEN=0
